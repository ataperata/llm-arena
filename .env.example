# auto: gateway when AI_GATEWAY_API_KEY is set, OpenAI-compatible when both
# OPENAI_COMPATIBLE_* vars are set, otherwise demo (mocked streams, no network).
# A Vercel deploy always has VERCEL_OIDC_TOKEN. Auto mode ignores that token so
# the app stays in demo until you opt in. Set ARENA_PROVIDER=gateway to use it.
ARENA_PROVIDER=auto

# Comma-separated model ids. Gateway ids look like provider/model.
# At most 6 are used. Defaults to GPT-5 mini, Claude Haiku 5.5, and Gemini 3.8 Flash.
ARENA_MODELS=openai/gpt-5-mini,anthropic/claude-haiku-5.5,google/gemini-3.8-flash

# Optional USD per 1M tokens. Unknown models show no cost until priced here.
# ARENA_PRICING={"openai/gpt-5-mini":{"inputPerMillion":0.25,"outputPerMillion":2}}

# Caps each live answer. Defaults to 800. Clamped to 64–4000.
# ARENA_MAX_OUTPUT_TOKENS=800

# Vercel AI Gateway. On Vercel, ARENA_PROVIDER=gateway can authenticate with OIDC
# and this key can stay unset. Locally, set the key.
# AI_GATEWAY_API_KEY=

# Any Chat Completions endpoint, including https://ai-gateway.vercel.sh/v1
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Optional shared leaderboard. Leave unset to keep votes in localStorage.
# Apply supabase/schema.sql yourself. Do not commit real keys.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
